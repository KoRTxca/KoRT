{
  "name": "kort-ide",
  "displayName": "KoRT AI",
  "description": "KoRT-first AI assistant for VSCodium",
  "version": "1.0.0",
  "publisher": "koort",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kort-explorer",
          "title": "KoRT",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "kort-explorer": [
        {
          "id": "kort-view",
          "name": "KoRT Sovereign AI",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "kort.login",
        "title": "KoRT: Login with SSO"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "^16.x",
    "typescript": "^4.9.0"
  }
}
